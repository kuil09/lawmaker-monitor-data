    {
      "statementId": "74e77342f3a87e21a1d43f7d34617337f1bb6a478e6c2d465c2172f07359423c",
      "documentId": "assembly-minutes-minutes-57335",
      "meetingTitle": "제22대국회 제439회 (정기회) 제3차 과학기술정보방송통신위원회",
