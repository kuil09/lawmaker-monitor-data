    {
      "statementId": "e116f90ba0911bbc27862ed43f9d7785f2a9d8301e16c65872c3160ccfac45dd",
      "documentId": "assembly-minutes-minutes-57171",
      "meetingTitle": "제22대국회 제438회 (임시회) 제1차 과학기술정보방송통신위원회",
