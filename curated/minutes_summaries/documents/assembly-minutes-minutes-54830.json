    {
      "statementId": "54e26a290f4deca01da6b908780bd7967b23a7f833d3b43066cd5927d39de990",
      "documentId": "assembly-minutes-minutes-54830",
      "meetingTitle": "제22대 제426회 산불피해지원대책특별위원회 회의록",
