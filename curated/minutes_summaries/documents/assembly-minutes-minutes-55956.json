    {
      "statementId": "075b0d86254d79cc4a96e0cb35dddfa4688fb68f83d1a4b774bea29201e03ff4",
      "documentId": "assembly-minutes-minutes-55956",
      "meetingTitle": "제22대국회 제430회 (임시회) 제1차 법제사법위원회",
