    {
      "statementId": "39cfb99bf6b4641b48f73986b947b90d6f5ffe33af9c7819d4be344ffce36211",
      "documentId": "assembly-minutes-minutes-52187",
      "meetingTitle": "제22대국회 제417회 (임시회) 제1차 교육위원회(예산결산기금심사소위원회)",
      "meetingDate": "2024-08-27",
      "committeeName": "교육위원회(예산결산기금심사소위원회)",
      "agendaTitle": "회의 일반 발언",
      "billIds": [],
      "speakerRole": "위원",
      "summary": "짧게 말씀드리겠습니다. 지금 제도개선 말씀하셔서, 저도 아까 과장님 말씀하신 것처럼 죽 학년도의 지원 인원하고 지원 금액을 살펴보니까 2020년도에 2만여 명이었는데 2023년도에 1만 3983명으로 줄긴 했더라고요. 그렇다면 왜 이렇게 자꾸 줄어드는지, 그냥 사고 핑계를 대실 게 아니라 예를 들어서 산업안전교육이라든지 노동인권교육이라든지 그런 사고가 나지 않도록 근본적인 대책을 마련하셔서 이것 정말 실효성 있게 운영될 수 있도록 도와주셔야 될 것 같습니다.",
      "evidenceExcerpt": "짧게 말씀드리겠습니다. 지금 제도개선 말씀하셔서, 저도 아까 과장님 말씀하신 것처럼 죽 학년도의 지원 인원하고 지원 금액을 살펴보니까 2020년도에 2만여 명이었는데 2023년도에 1만 3983명으로 줄긴 했더라고요. 그렇다면 왜 이렇게 자꾸 줄어드는지, 그냥 사고 핑계를 대실 게 아니라 예를 들어서 산업안전교육이라든지 노동인권교육이라든지 그런 사고가 나지 않도록 근본적인 대책을 마련하셔서 이것 정말 실효성 있게 운영될 수 있도록 도와주셔야 될 것 같습니다.",
      "sourceUrl": "https://record.assembly.go.kr/assembly/viewer/minutes/xml.do?id=52187&type=view",
      "sourceFragment": "#spk_708",
      "sourceDocumentPath": "raw/documents/assembly-minutes/2024/08/27/assembly-minutes-minutes-52187/latest.html",
