    {
      "statementId": "63e0f252eea2a08f1e60177b591a9130cdb64877409beb3e0dd749dfdc9c7201",
      "documentId": "assembly-minutes-minutes-55005",
      "meetingTitle": "제22대국회 제427회 (임시회) 제1차 기획재정위원회",
      "meetingDate": "2025-07-09",
      "committeeName": "기획재정위원회",
      "agendaTitle": "회의 일반 발언",
      "billIds": [],
      "speakerRole": "위원장대리",
      "summary": "이 두 안건은 7월 3일 자로 우리 위원회에 회부된 국세청장후보자 임광현의 인사청문요청안과 그다음 날인 7월 4일 자로 회부된 부총리겸기획재정부장관후보자 구윤철 인사청문요청안에 대한 인사청문회 일정 등을 정하기 위해서 위원장이 간사님들과 협의해서 작성한 실시계획서를 채택하고자 하는 것입니다. 주요 내용을 말씀드리면, 임광현 후보자에 대한 인사청문회는 7월 15일 화요일 오전 10시, 구윤철 후보자에 대한 인사청문회는 7월 17일 목요일 오전 10시에 실시하고 경과보고서 채택 일정은 인사청문회 종료 후 간사님들 간의 협의를 통해서 결정하도록 하겠습니다. 그러면 의사일정 제2항 국세청장후보자(임광현) 인사청문회 실시계획서 채택의 건은 배부해 드린 유인물과 같이 의결하고자 하는데 이의 없으십니까?",
