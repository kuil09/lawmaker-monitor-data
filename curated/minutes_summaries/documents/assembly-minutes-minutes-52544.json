    {
      "statementId": "3123e8a5bfc93b2ac7f11f6e4de98747b48d3e51710a7e6c9f689850f89a8bf4",
      "documentId": "assembly-minutes-minutes-52544",
      "meetingTitle": "제22대국회 제418회 (정기회) 제1차 정보위원회",
      "meetingDate": "2024-09-26",
      "committeeName": "정보위원회",
      "agendaTitle": "회의 일반 발언",
      "billIds": [],
      "speakerRole": "위원",
      "summary": "저는 실질적으로 이렇게 해서는 실효적인 국정감사가 진행되기 어렵다라고 생각을 합니다. 국정원에 1급 부서장들이 많습니다만 지방 근무해서 올라오기 어려운 부서장은 모르겠지만 적어도 본부의 부서장들은 국정감사의 증인으로 채택하는 것이 타당하다 이렇게 생각하고 말씀드립니다. 이 시간에 국가정보원이 아무리 정보를 다루는 기관이라고 하지만 국가예산의 대단히 많은 예산을 쓰고 있고 또 그러한 중요한 일을 하기 때문에 1급 이상의 상위 직위자들이 굉장히 많은 포션을 차지하고 있습니다.",
      "evidenceExcerpt": "저는 실질적으로 이렇게 해서는 실효적인 국정감사가 진행되기 어렵다라고 생각을 합니다. 국정원에 1급 부서장들이 많습니다만 지방 근무해서 올라오기 어려운 부서장은 모르겠지만 적어도 본부의 부서장들은 국정감사의 증인으로 채택하는 것이 타당하다 이렇게 생각하고 말씀드립니다. 이 시간에 국가정보원이 아무리 정보를 다루는 기관이라고 하지만 국가예산의 대단히 많은 예산을 쓰고 있고 또 그러한 중요한 일을 하기 때문에 1급 이상의 상위 직위자들이 굉장히 많은 포션을 차지하고 있습니다.",
      "sourceUrl": "https://record.assembly.go.kr/assembly/viewer/minutes/xml.do?id=52544&type=view",
      "sourceFragment": "#spk_12",
      "sourceDocumentPath": "raw/documents/assembly-minutes/2024/09/26/assembly-minutes-minutes-52544/latest.html",
      "sourceContentSha256": "9d0bd2862935a02d622120dc60107a58a79f6ea31a4c61cf41ac19f6f6be454e",
      "sourceKind": "official_minutes_transcript",
      "memberId": "W3U3344O",
      "name": "이기헌",
