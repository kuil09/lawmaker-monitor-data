    {
      "statementId": "abb40642def872a6dc41250fb5eec8398b39bbd6a143fb1dd35e49673f648f57",
      "documentId": "assembly-minutes-minutes-52544",
      "meetingTitle": "제22대국회 제418회 (정기회) 제1차 정보위원회",
