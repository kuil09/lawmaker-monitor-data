    {
      "statementId": "2561e155aab0a4ec2e45e3b4f0d7c0c7deabacc480033e0eacd016666bfd4ab6",
      "documentId": "assembly-minutes-minutes-52525",
      "meetingTitle": "제22대국회 제418회 (정기회) 제3차 국토교통위원회",
