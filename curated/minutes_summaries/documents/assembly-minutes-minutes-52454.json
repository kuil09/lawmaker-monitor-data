    {
      "statementId": "2c1fb807b841001b3b602ce67b6c18d504ab6a1c4ce4b6dd5929cecec121d028",
      "documentId": "assembly-minutes-minutes-52454",
      "meetingTitle": "제22대국회 제418회 (정기회) 제1차 농림축산식품해양수산위원회",
