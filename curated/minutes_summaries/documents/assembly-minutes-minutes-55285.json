    {
      "statementId": "8f7bf906a17878a22a15dd74aef8c4b5886bbf9b647f47964f63084d526e64b5",
      "documentId": "assembly-minutes-minutes-55285",
      "meetingTitle": "제22대국회 제429회 (정기회) 제1차 법제사법위원회(법안심사제1소위원회)",
