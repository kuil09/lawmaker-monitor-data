    {
      "statementId": "01449d79de2974adc478b9f8678b2cecedb46eccb4dc35ec2c9ae3713f42a8f3",
      "documentId": "assembly-minutes-minutes-55096",
      "meetingTitle": "제22대국회 제427회 (임시회) 제2차 국회운영위원회",
      "meetingDate": "2025-07-29",
      "committeeName": "국회운영위원회",
      "agendaTitle": "회의 일반 발언",
      "billIds": [],
      "speakerRole": "위원",
      "summary": "모든 협의의 과정이라는 것이 모든 사람이 만족할 수는 없습니다. 그리고 윤리특위가 사실은 22대 들어와서 이렇게 늦게까지 구성이 안 된 경우도 제 기억에는 없습니다. 그러나 22대 들어오면서 굉장히 여야가 극한 대립을 이뤄 왔고 그 과정 속에서 합리적 의사결정이라기보다는 다수의 힘으로 모든 것이 결정되는 그런 과정이 반복되면서…… 당시에는 소수 여당이었지요.",
      "evidenceExcerpt": "모든 협의의 과정이라는 것이 모든 사람이 만족할 수는 없습니다. 그리고 윤리특위가 사실은 22대 들어와서 이렇게 늦게까지 구성이 안 된 경우도 제 기억에는 없습니다. 그러나 22대 들어오면서 굉장히 여야가 극한 대립을 이뤄 왔고 그 과정 속에서 합리적 의사결정이라기보다는 다수의 힘으로 모든 것이 결정되는 그런 과정이 반복되면서…… 당시에는 소수 여당이었지요.",
      "sourceUrl": "https://record.assembly.go.kr/assembly/viewer/minutes/xml.do?id=55096&type=view",
      "sourceFragment": "#spk_31",
      "sourceDocumentPath": "raw/documents/assembly-minutes/2025/07/29/assembly-minutes-minutes-55096/latest.html",
      "sourceContentSha256": "444c63c25e70bc90b983aa1271506c0c8cb2018deb7b6b9f1aba5e2550574bc3",
      "sourceKind": "official_minutes_transcript",
      "memberId": "MU69217P",
      "name": "유상범",
      "party": "국민의힘"
    },
    {
      "statementId": "486a01370604472b630a19d96656020c40b69a627426032cfee32b962bbd4301",
      "documentId": "assembly-minutes-minutes-55096",
      "meetingTitle": "제22대국회 제427회 (임시회) 제2차 국회운영위원회",
      "meetingDate": "2025-07-29",
      "committeeName": "국회운영위원회",
      "agendaTitle": "회의 일반 발언",
      "billIds": [],
      "speakerRole": "위원",
      "summary": "늦게나마 윤리특위가 구성된 것에 대해서 매우 다행스럽게 생각합니다. 좀 전에 동료 위원께서 먼저 말씀을 하셨습니다마는 22대 국회에는 7개 정당이 들어와 있고 또 국민들의 다양성을 보장할 수 있는 의견을 충분하게 개진할 수 있어야 된다고 생각합니다. 그리고 지금 현재 22대 국회에 29건의 징계안이 올라와 있는데요, 민주당이 10건, 국민의힘이 18건.",
      "evidenceExcerpt": "늦게나마 윤리특위가 구성된 것에 대해서 매우 다행스럽게 생각합니다. 좀 전에 동료 위원께서 먼저 말씀을 하셨습니다마는 22대 국회에는 7개 정당이 들어와 있고 또 국민들의 다양성을 보장할 수 있는 의견을 충분하게 개진할 수 있어야 된다고 생각합니다. 그리고 지금 현재 22대 국회에 29건의 징계안이 올라와 있는데요, 민주당이 10건, 국민의힘이 18건.",
