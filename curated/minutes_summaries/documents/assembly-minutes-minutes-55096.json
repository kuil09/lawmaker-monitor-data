    {
      "statementId": "b202f76ef45e4840a961d35d5bed66f87cd8d2abdece76b344c49f889de11c5b",
      "documentId": "assembly-minutes-minutes-55096",
      "meetingTitle": "제22대국회 제427회 (임시회) 제2차 국회운영위원회",
      "meetingDate": "2025-07-29",
      "committeeName": "국회운영위원회",
      "agendaTitle": "회의 일반 발언",
      "billIds": [],
      "speakerRole": "위원",
      "summary": "작년의 반헌법적 내란 사태 이후 의회 중심의 대한민국으로 변화를 만들어 가는 작금의 시기에 무엇보다 국회의원들의 윤리의식을 높이고 국회 스스로의 자정 능력이 있음을 증명하는 과제가 있다라고 생각을 합니다. 전체 의원의 8%에 달하는 비교섭단체 의원이 있는데 올라온 이 안건에 당 이름을 국민의힘 6인, 더불어민주당 6인 이렇게 적시해서 올라온 것은 비교섭단체가 윤리특위 위원이 될 수 있는 것을 원천적으로 차단하는 문제가 있습니다. 두 번째는요 같은 줄에 앉아 계신 분들께 죄송합니다마는 윤리특위 절반을 지금의 현실에서 국민의힘 의원이 차지하도록 구성하는 게 지금 국민들이 국회를 바라보는 시선에서 납득할 수 있겠는가라는 말씀을 드릴 수밖에 없습니다.",
      "evidenceExcerpt": "작년의 반헌법적 내란 사태 이후 의회 중심의 대한민국으로 변화를 만들어 가는 작금의 시기에 무엇보다 국회의원들의 윤리의식을 높이고 국회 스스로의 자정 능력이 있음을 증명하는 과제가 있다라고 생각을 합니다. 전체 의원의 8%에 달하는 비교섭단체 의원이 있는데 올라온 이 안건에 당 이름을 국민의힘 6인, 더불어민주당 6인 이렇게 적시해서 올라온 것은 비교섭단체가 윤리특위 위원이 될 수 있는 것을 원천적으로 차단하는 문제가 있습니다. 두 번째는요 같은 줄에 앉아 계신 분들께 죄송합니다마는 윤리특위 절반을 지금의 현실에서 국민의힘 의원이 차지하도록 구성하는 게 지금 국민들이 국회를 바라보는 시선에서 납득할 수 있겠는가라는 말씀을 드릴 수밖에 없습니다.",
      "sourceUrl": "https://record.assembly.go.kr/assembly/viewer/minutes/xml.do?id=55096&type=view",
      "sourceFragment": "#spk_9",
