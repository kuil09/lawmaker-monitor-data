    {
      "statementId": "a38584542b16c34dca3897274d1c6932c33c9ed26e36b4164d50b3261c149bf4",
      "documentId": "assembly-minutes-minutes-52506",
      "meetingTitle": "제22대국회 제418회 (정기회) 제1차 환경노동위원회",
