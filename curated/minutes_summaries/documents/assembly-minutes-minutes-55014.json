    {
      "statementId": "dd5407f474e7cc92cea9b289209fe6311fa898b3e9b2ca88b586ed853763d027",
      "documentId": "assembly-minutes-minutes-55014",
      "meetingTitle": "제22대국회 제427회 (임시회) 제1차 국회운영위원회",
