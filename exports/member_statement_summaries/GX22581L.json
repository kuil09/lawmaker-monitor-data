    {
      "statementId": "d412a21fd043ca9899015705bd4f3d5741408a4c232df200da499d92f9931494",
      "documentId": "assembly-minutes-minutes-52111",
      "meetingTitle": "제22대국회 제416회 (임시회) 제2차 정무위원회",
