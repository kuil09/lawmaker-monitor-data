    {
      "statementId": "531850104c6660283648e19a3185ec44cea262d8f25e0bf17a29f232a050e6da",
      "documentId": "assembly-minutes-minutes-52064",
      "meetingTitle": "제22대국회 제415회 (임시회) 제3차 국회운영위원회",
      "meetingDate": "2024-07-01",
