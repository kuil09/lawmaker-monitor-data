    {
      "statementId": "9e03bbc1eafd63137b19548071b780e805bb54ad7b9fbaef0ccb06b4cad03a13",
      "documentId": "assembly-minutes-minutes-52559",
      "meetingTitle": "제22대국회 제418회 (정기회) 제1차 예산결산특별위원회",
      "meetingDate": "2024-09-02",
