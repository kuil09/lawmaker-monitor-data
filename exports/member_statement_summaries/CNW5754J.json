    {
      "statementId": "a878fad4532988c3f5a63f6610b380dcc58d9cee8620b86c0122f727b2633b35",
      "documentId": "assembly-minutes-minutes-56582",
      "meetingTitle": "제22대국회 제434회 (임시회) 제3차 법제사법위원회",
