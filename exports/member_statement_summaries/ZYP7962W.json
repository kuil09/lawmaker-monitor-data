    {
      "statementId": "3eaaab55f4e33828a7b95665bef996e26f1e1ec2dafa0622579fa0e369bfd59e",
      "documentId": "assembly-minutes-minutes-56549",
      "meetingTitle": "제22대국회 제434회 (임시회) 제1차 외교통일위원회",
