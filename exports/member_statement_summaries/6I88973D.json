      "sourceKind": "official_minutes_transcript"
    },
    {
      "statementId": "332ae3eb9ec882826a0f7d49493a6ba3cb71ac0b294b725a7fdedad7e2866fc9",
      "documentId": "assembly-minutes-minutes-52063",
      "meetingTitle": "제22대국회 제415회 (임시회) 제2차 국회운영위원회",
      "meetingDate": "2024-06-21",
