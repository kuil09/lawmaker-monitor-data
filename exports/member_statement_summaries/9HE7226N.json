      "sourceKind": "official_minutes_transcript"
    },
    {
      "statementId": "0b61ac6182ba2fa61bcf62df7e8f2ef8d49d482e7c9d570166255cc70147714d",
      "documentId": "assembly-minutes-minutes-52064",
      "meetingTitle": "제22대국회 제415회 (임시회) 제3차 국회운영위원회",
