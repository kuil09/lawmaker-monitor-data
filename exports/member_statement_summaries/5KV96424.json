      "sourceKind": "official_minutes_transcript"
    },
    {
      "statementId": "34daac30d25754cc5614fc7ce53604e5b41bf5c4d4f580493a318e75540c8547",
      "documentId": "assembly-minutes-minutes-52112",
      "meetingTitle": "제22대 제416회 정무위원회 회의록",
      "meetingDate": "2024-07-24",
