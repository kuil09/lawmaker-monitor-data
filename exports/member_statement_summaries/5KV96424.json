      "sourceFragment": "#spk_1176",
      "sourceDocumentPath": "raw/documents/assembly-minutes/2024/07/22/assembly-minutes-minutes-52111/latest.html",
      "sourceContentSha256": "ea7502737365902e41ca86e358e16641d669a15dd1de0b7c6595d15db4dfff53",
