      "paragraphs": [
        "이성권 위원님 고맙습니다.",
        "다음 김병기 위원님 인사말씀이 있겠습니다."
      ],
      "sourceFragment": "#spk_6"
    },
    {
      "statementId": "spk_7",
      "agendaItemId": "item0",
      "speakerName": "김병기",
