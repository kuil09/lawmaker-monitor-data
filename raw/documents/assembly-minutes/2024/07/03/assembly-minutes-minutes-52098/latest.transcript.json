  "meetingTitle": "제22대국회 제415회 (임시회) 제4차 국토교통위원회",
  "meetingDate": "2024-07-03",
  "committeeName": "국토교통위원회",
  "agendaItems": [
    {
      "agendaItemId": "item1",
      "title": "1. 간사 선임의 건",
      "billIds": [],
      "billDetailUrl": null
    },
    {
      "agendaItemId": "item2",
      "title": "o 간사(권영진) 인사",
      "billIds": [],
