      "agendaItemId": "item4",
      "title": "4. 국가정보원직원법 일부개정법률안(대안)",
      "billIds": [],
      "billDetailUrl": "https://likms.assembly.go.kr/bill/billDetail.do?billId=PRC_Y2M6G0C2G0G6K1Z4P3N9W1D0V0G6B9"
