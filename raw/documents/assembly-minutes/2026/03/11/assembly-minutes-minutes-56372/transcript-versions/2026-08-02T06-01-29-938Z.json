    {
      "agendaItemId": "item2",
      "title": "2. 행정소송법 일부개정법률안(송석준 의원 대표발의)(의안번호 2205762)",
      "billIds": [
        "2205762"
      ],
      "billDetailUrl": "https://likms.assembly.go.kr/bill/billDetail.do?billId=PRC_V2T4U1T1R2R1N1O0M2N5L4J3K5S8T2"
