      "agendaItemId": "item8",
      "speakerName": "최재봉",
      "speakerRole": "국세청차장",
      "sourceMemberId": "0",
      "officialProfileUrl": null,
      "paragraphs": [
        "의견 없고 수용하도록 하겠습니다."
      ],
      "sourceFragment": "#spk_33"
    },
    {
      "statementId": "spk_34",
      "agendaItemId": "item8",
      "speakerName": "정일영",
      "speakerRole": "소위원장",
      "sourceMemberId": "6636",
      "officialProfileUrl": "https://www.assembly.go.kr/members/22nd/CHUNGILYOUNG",
      "paragraphs": [
